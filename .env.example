# ───────────────────────────────────────────────────────────────
# IRO environment — copy to `.env.local` and fill in to enable LIVE data.
# With NONE of these set, the app runs on the bundled real-data snapshot
# in lib/seed.ts (the projects/tasks/Drive folders captured on 2026-05-30).
# ───────────────────────────────────────────────────────────────

# --- Notion (Projects + IRO Tasks) ---
# Create an internal integration at https://www.notion.so/my-integrations
# then SHARE the "Projects" DB, the "IRO Tasks" DB, and each project page with it.
NOTION_TOKEN=
# Database IDs (already known for this workspace):
# Projects source = "Project Hub" DB (rows are the projects).
NOTION_PROJECTS_DB=355559df-de85-8010-af56-f00bc9851a06
NOTION_TASKS_DB=63bad047-5a4e-4039-9cf8-526a2c979658

# --- Google OAuth client (shared by Drive, Calendar, Gmail, Contacts) ---
# Google Cloud project → create an OAuth "Desktop app" client, and ENABLE these
# APIs on the project: Drive, Google Calendar, Gmail, People (+ Cloud Vision for
# the business-card OCR). Durable path: set CLIENT_ID + CLIENT_SECRET, then run
#   node scripts/get-google-token.mjs            # main account → Drive+Calendar+Contacts(+Gmail Sihoon)
#   node scripts/get-google-token.mjs --account=jinho   # second inbox → GMAIL_REFRESH_TOKEN_JINHO
# The helper writes the tokens below into .env.local for you (never paste by hand).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=
# Port the one-time OAuth helper listens on (loopback redirect). Default 53682.
GOOGLE_OAUTH_PORT=53682

# --- Mail (Gmail), second inbox ---
GMAIL_REFRESH_TOKEN_JINHO=
# GMAIL_REFRESH_TOKEN_SIHOON=   # optional; falls back to GOOGLE_REFRESH_TOKEN if unset

# --- Contacts OCR (business-card scan) — Google Cloud Vision ---
# Enable Cloud Vision API + a billing account (first 1,000 images/month free).
GOOGLE_VISION_API_KEY=

# --- Code (GitHub) ---
# GitHub → Settings → Developer settings → fine-grained PAT (read-only).
GITHUB_TOKEN=
GITHUB_ORG=                     # org name OR your username

# --- Tax (세금) — Popbill 전자세금계산서/현금영수증 ---
# 미설정 시 공개 TESTER 샌드박스로 동작(실제 발번은 제한될 수 있음).
# 가입 후 본인 키를 넣으면 자동으로 본인 계정 테스트베드를 사용.
POPBILL_LINK_ID=                # 팝빌 연동회원 LinkID
POPBILL_SECRET_KEY=             # 팝빌 SecretKey
POPBILL_CORP_NUM=               # 발행 주체(팝빌 회원) 사업자번호 10자리, 숫자만
POPBILL_IS_TEST=true            # true=테스트베드, false=운영(실제 국세청)
# POPBILL_OFF=true              # 팝빌 호출 완전 비활성화(로컬 저장만)
DATA_GO_KR_KEY=                 # 무료 data.go.kr 키 → 국세청 사업자번호 상태조회

# --- Banking (입출금) ---
# Works locally now (manual + CSV import). Auto bank-fetch (CODEF/오픈뱅킹) = later phase.

# --- Slack (Comms) ---
# Create a Slack app → add scopes (channels:read, channels:history, groups:read,
# groups:history, chat:write, users:read) → install to workspace. Then set a token:
#   • SLACK_USER_TOKEN (xoxp-…) posts AS you (preferred for "my message in Slack")
#   • SLACK_BOT_TOKEN  (xoxb-…) posts as the IRO bot
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=       # Events API request signing (real-time inbound webhook)

# --- Supabase (production DB; local falls back to .data/*.json) ---
# Create a project at supabase.com → SQL Editor → run supabase/schema.sql.
# Settings → API: copy Project URL + the service_role key (server-side, keep secret).
# When these are set, the stores use Postgres; unset → local JSON files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=        # client key — for Supabase Realtime subscription (later)
