# ───────────────────────────────────────────────────────────────
# IRO environment — copy to `.env.local` and fill in to enable LIVE data.
# With NONE of these set, the app runs on the bundled real-data snapshot
# in lib/seed.ts (the projects/tasks/Drive folders captured on 2026-05-30).
# ───────────────────────────────────────────────────────────────

# --- Notion (Projects + IRO Tasks) ---
# Create an internal integration at https://www.notion.so/my-integrations
# then SHARE the "Projects" DB, the "IRO Tasks" DB, and each project page with it.
NOTION_TOKEN=
# Database IDs (already known for this workspace):
# Projects source = "Project Hub" DB (rows are the projects).
NOTION_PROJECTS_DB=355559df-de85-8010-af56-f00bc9851a06
NOTION_TASKS_DB=63bad047-5a4e-4039-9cf8-526a2c979658

# --- Google Drive (Company Database) ---
# Google Cloud project → enable Drive API → create an OAuth "Desktop app" client.
# Durable path (recommended): set CLIENT_ID + CLIENT_SECRET below, then run
#   node scripts/get-google-token.mjs
# to mint GOOGLE_REFRESH_TOKEN once. lib/drive.ts auto-exchanges it for access
# tokens on each request. (GOOGLE_ACCESS_TOKEN is an optional quick-test override.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=
# Port the one-time OAuth helper listens on (loopback redirect). Default 53682.
GOOGLE_OAUTH_PORT=53682
